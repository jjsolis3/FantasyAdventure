# Copy to .env for local development. In production these are set in the
# Coolify environment variables tab instead — never commit real values.

# --- Database ---------------------------------------------------------------
# Local (via docker compose): the db service is reachable on localhost:5432.
DATABASE_URL="postgresql://hearthlight:hearthlight@localhost:5432/hearthlight?schema=public"
#
# In Coolify, use the internal hostname of your Postgres resource, e.g.
# DATABASE_URL="postgresql://postgres:PASSWORD@postgresql-abc123:5432/postgres"

# --- The Game Master --------------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, llama.cpp server.
# Note the /v1 suffix — Ollama serves its OpenAI-compatible API there.
AI_BASE_URL="http://192.168.1.50:11434/v1"
AI_MODEL="llama3.1:8b"
# Most local servers ignore this; set it if yours requires a key.
AI_API_KEY=""

# --- App --------------------------------------------------------------------
# Shown on the health endpoint. Handy for confirming which build is live.
APP_VERSION="dev"
# Set to false to stop re-seeding storylines on every container start.
SEED_ON_START="true"
