# Copy to .env for local development. In production these are set in the
# Coolify environment variables tab instead — never commit real values.

# --- Database ---------------------------------------------------------------
# Local (via docker compose): the db service is reachable on localhost:5432.
DATABASE_URL="postgresql://hearthlight:hearthlight@localhost:5432/hearthlight?schema=public"
#
# In Coolify, use the internal hostname of your Postgres resource, e.g.
# DATABASE_URL="postgresql://postgres:PASSWORD@postgresql-abc123:5432/postgres"

# --- The Game Master --------------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, llama.cpp server.
# Note the /v1 suffix — Ollama serves its OpenAI-compatible API there.
#
# REPLACE THE ADDRESS BELOW. It is an example, not your server. Run
# `hostname -I` on the machine running Ollama to find the real one. See
# docs/ollama.md for the full setup, including making Ollama listen on the LAN
# at all — by default it binds to 127.0.0.1 and refuses the app's connection.
AI_BASE_URL="http://192.168.1.50:11434/v1"   # <- EXAMPLE ONLY, yours will differ
AI_MODEL="qwen2.5:latest"
# Optional: a second model used only for narration. qwen2.5 tends to be the
# more reliable at JSON while llama3.1 and gemma narrate better. Leave unset to
# use AI_MODEL for everything.
AI_NARRATION_MODEL=""
# Most local servers ignore this; set it if yours requires a key.
AI_API_KEY=""
# Prompt budget. Lower this if your model has a small context window —
# phi3:mini defaults to 4k, which fills fast. `ollama show <model>` reports it.
AI_MAX_CONTEXT_TOKENS="3000"
# Raise for a large model on modest hardware.
AI_TIMEOUT_MS="120000"
# How much a thinking model should reason: none | low | medium | high.
#
# Set this to "none" for Ollama. Hybrid reasoning models — Qwen3 among them —
# think by default, and the thinking is charged against the same output budget
# as the answer, so a turn can end with an empty reply. The game does not need
# it: the model only decides whether a roll is called for, the server rolls,
# and the model narrates the result it is handed.
#
# Leave it blank for OpenAI, which rejects values it does not recognise. Blank
# means the field is left off the request entirely.
AI_REASONING_EFFORT=""

# --- Pictures (optional) ----------------------------------------------------
# One illustration per chapter. Off unless you switch it on, because unlike
# everything else here it costs money every time it is used — roughly a penny or
# two a chapter. Usually a different provider from the storyteller: Anthropic
# does not draw.
#
# Easier to set at Settings → Storyteller, which stores the key encrypted. These
# are the fallback, and are only read while no settings have been saved.
IMAGE_ENABLED="false"
IMAGE_BASE_URL="https://api.openai.com/v1"
IMAGE_MODEL="gpt-image-1"
IMAGE_API_KEY=""

# Encrypts API keys stored via the settings page. Must be at least 16
# characters. Without it the app still works — local models need no key — but a
# cloud API key cannot be saved, because storing it unencrypted would be worse
# than refusing. Generate one with: openssl rand -base64 32
SETTINGS_SECRET=""

# --- App --------------------------------------------------------------------
# Shown on the health endpoint. Handy for confirming which build is live.
APP_VERSION="dev"

# Where this installation lives, with no trailing slash. Used to build password
# reset links, and nothing else.
#
# This is NOT derived from the request's Host header, deliberately. A reset link
# is the one thing here that hands an account to whoever holds it, and a header
# an attacker controls would let them have the link built to point at their own
# machine and emailed to your address. Unset, reset emails are simply not sent
# and the screen says to ask whoever runs Hearthlight.
APP_URL="https://hearthlight.example.com"
# Set to false to stop re-seeding storylines on every container start.
SEED_ON_START="true"

# --- Email ------------------------------------------------------------------
# Sent for exactly one reason: password reset links for accounts that have an
# address. Nothing else here emails anybody — no digests, no notifications.
#
# A child signs in with a username and holds no address at all, so she is never
# emailed and never could be; the grown-up next to her sets her password from
# Settings -> Your family instead. These two variables are only about the
# grown-ups.
#
# One connection URL, because every provider hands you exactly this string and
# splitting it into five fields is an invitation to get one wrong. Anything that
# speaks SMTP works: a Gmail app password, Fastmail, SES, Resend's SMTP bridge.
#
#   smtps://user:password@smtp.example.com:465   (implicit TLS, port 465)
#   smtp://user:password@smtp.example.com:587    (STARTTLS, port 587)
#
# A password with @ / : or # in it must be percent-encoded.
#
# Leave both empty and the feature is OFF rather than broken: the forgotten-
# password screen says to ask whoever runs Hearthlight, which is true and
# actionable, instead of pretending to send and silently dropping it.
#
# Whatever you use, the sending domain needs SPF and DKIM records or the mail
# lands in spam.
SMTP_URL=""
MAIL_FROM="Hearthlight <hearth@example.com>"

# Which account administers this installation: the storyteller's settings, the
# shared adventure library, what everything has cost, and which accounts are in
# which family. Nobody else gets it, however early they register.
#
# Leave it empty and the old rule applies instead — whoever registers first —
# which is fine for a copy on your own server and is not fine for a public one:
# an empty database is one restored backup away, and the first stranger to
# reach /register would inherit all of the above.
PLATFORM_ADMIN_EMAIL=""
