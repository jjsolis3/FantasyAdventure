// Hearthlight — database schema
//
// M0 established the storyline templates. M1 adds accounts: invite-gated
// registration, password login and server-side sessions.
// Characters, campaigns, scenes and the turn log arrive in later milestones.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Who throws the dice.
enum DiceMode {
  /// The app rolls. Right when the dice are in another room, or nobody owns any.
  SERVER
  /// The table rolls its own and types the number in. See lib/game/table-dice.ts
  /// for what this trades away and why it is the correct trade for one family
  /// sitting round one table.
  TABLE
}

/// How gentle the Game Master should be. Set per storyline as a default,
/// later overridden per campaign.
enum Tone {
  /// Warm and low-stakes. Setbacks are inconveniences, never threats.
  COZY
  /// Real tension and real stakes, but still no gore and no death.
  ADVENTUROUS
  /// Frightening on purpose: dread, wrongness, something following. The floor
  /// underneath it does not move — nobody dies, nobody is hurt, and the story
  /// always leaves a way through.
  SPOOKY
}

/// Drives vocabulary, sentence length and narration density in the GM prompt.
enum ReadingLevel {
  EARLY_READER
  MIDDLE_GRADE
  TEEN
  /// Mixed-age table: narrate for the youngest, leave asides for the oldest.
  FAMILY_MIXED
}

enum Role {
  /// Can create invite codes and manage other accounts.
  ADMIN
  PLAYER
}

/// Someone who can sign in. On a shared screen this is usually one adult per
/// household rather than one row per family member — the adventurers
/// themselves become Characters in a later milestone.
model User {
  id           String @id @default(cuid())
  /// Always stored lowercased so sign-in is case-insensitive.
  email        String @unique
  passwordHash String
  displayName  String
  role         Role   @default(PLAYER)

  /// Household defaults, offered as the starting point when setting up a
  /// campaign so the table's usual tone does not have to be re-picked.
  defaultReadingLevel ReadingLevel @default(FAMILY_MIXED)
  defaultTone         Tone         @default(COZY)

  /// Throttles password guessing. Reset to zero on any successful sign-in.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions       AuthSession[]
  characters     Character[]
  campaigns      Campaign[]
  uploadedImages CampaignImage[]
  chapterImages  ChapterImage[]
  invitesCreated InviteCode[]  @relation("InviteCreator")
  inviteRedeemed InviteCode?   @relation("InviteRedeemer")
  roundAnswers   RoundAnswer[]
  partyInvitesSent PartyInvite[] @relation("PartyInviter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Registration is invite-only: the app sits on a public URL, and without this
/// anyone who finds it could create an account.
model InviteCode {
  id   String  @id @default(cuid())
  code String  @unique
  /// Free-text reminder of who the code was meant for.
  note String?

  createdById String?
  createdBy   User?   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// One code, one account. The unique constraint enforces single use even if
  /// two registrations race.
  redeemedById String?   @unique
  redeemedBy   User?     @relation("InviteRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt   DateTime?

  expiresAt DateTime?

  /// Generated automatically when the database has no users at all, and printed
  /// to the container logs so the first admin account can be created without
  /// anyone having to seed credentials by hand.
  isBootstrap Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdById])
}

/// Server-side session. The cookie carries an opaque random token; only its
/// SHA-256 hash is stored, so a leaked database dump cannot be replayed as a
/// login. Sessions are revocable, which a stateless JWT would not be.
model AuthSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Roughly how old the character is. Kept as bands rather than a number
/// because it exists to tell the Game Master how to write them, not to do
/// arithmetic with.
enum AgeBand {
  CHILD
  TEEN
  GROWNUP
  ELDER
}

/// An adventurer. Characters belong to the account that made them, so on a
/// shared screen one household owns the whole party.
model Character {
  id     String @id @default(cuid())
  /// Who answers for them. Changed by a handover — everything an adventurer has
  /// earned hangs off their id rather than this, so moving them to a child's
  /// own account costs them nothing.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set while this adventurer is being offered to another account, and cleared
  /// the moment somebody claims them. A code rather than a chosen recipient:
  /// picking one would mean showing every player a list of the household's
  /// accounts, and this is a thing you read out across the kitchen table.
  handoverCode String? @unique

  name        String
  /// Free text, because "Fox-folk" should not be the limit of anyone's imagination.
  race        String
  /// The character's calling — Guardian, Trickster, Healer and so on.
  archetype   String
  gender      String?
  /// Stored verbatim and used by the Game Master when narrating.
  pronouns    String  @default("they/them")
  ageBand     AgeBand @default(GROWNUP)
  /// Appearance and manner, in the player's own words. Feeds the GM prompt.
  description String?

  // The seven stats. Constrained by a point budget that is enforced in code
  // (see lib/game/rules.ts) rather than by the database, so the rule can change
  // without a migration invalidating characters that were already legal — which
  // is exactly what happened when Grace, Luck and Grit were added: the budget
  // moved from 12 to 21 and every existing character stayed legal, because the
  // default below is the same neutral value the budget is built from.
  might Int @default(3)
  wits  Int @default(3)
  heart Int @default(3)
  spark Int @default(3)
  grace Int @default(3)
  luck  Int @default(3)
  grit  Int @default(3)

  /// Earned through play. Level is derived from xp, never set directly.
  xp    Int @default(0)
  level Int @default(1)

  skills        CharacterSkill[]
  knacks        CharacterKnack[]
  acquaintances Acquaintance[]
  practices     Practice[]
  inventory     InventoryItem[]
  keepsakes     Keepsake[]
  questFinds    QuestObjective[]
  personalQuests Quest[]         @relation("PersonalQuests")
  partyMemberships PartyMember[]
  partyInvites  PartyInvite[]
  roundAnswers  RoundAnswer[]
  abilityUses   AbilityUse[]
  portrait      CharacterPortrait?
  /// Relationships where this character is the "A" side, and the "B" side.
  relationshipsA Relationship[]  @relation("RelationshipA")
  relationshipsB Relationship[]  @relation("RelationshipB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Somebody this adventurer has met, who outlives the adventure.
///
/// NPC memories have always been recorded, and have always died with the
/// campaign that made them. So a family could spend four evenings winning over
/// a frightened beekeeper, finish the story, and start the next one in a world
/// where nobody had ever met him — which is a strange thing for a game about
/// a family building a life together.
///
/// Hung off the character rather than the account, so it survives an adventurer
/// being handed to a child's own sign-in, and so a reunion can be personal: the
/// beekeeper remembers *Mira*, not "the party".
model Acquaintance {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Normalised, for recognising the same person again: "beekeeper".
  key  String
  /// As the storyteller named them.
  name String
  /// What they are like, carried over from what was remembered about them.
  about String

  /// Which adventure they were met on. Kept as a title as well as an id,
  /// because the id goes when the campaign does and the memory should not.
  metInCampaignId    String?
  metInCampaignTitle String

  /// How many adventures they have now turned up in. A reunion with somebody
  /// met three times reads differently from a first one, and the storyteller is
  /// told which it is.
  timesMet Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, key])
  @@index([characterId])
}

/// Something she can do that she could not do before.
///
/// Reaching a level used to be announced and then read by nothing at all — the
/// number went up, the table was told, and not one thing about the character
/// changed. A knack is what a level buys: one, chosen from three, and the three
/// are drawn from what she has actually been doing rather than from a menu
/// everybody sees.
model CharacterKnack {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Matches a key in lib/game/knacks.ts.
  key String
  /// Which level bought it, so a sheet can tell the story of her growing up.
  chosenAtLevel Int

  createdAt DateTime @default(now())

  @@unique([characterId, key])
  @@index([characterId])
}

/// A kind of thing this adventurer keeps trying.
///
/// Skill experience used to be awarded only when a check happened to name a
/// skill she already had. So a girl who said "I climb the drainpipe" — with
/// nothing on her sheet about climbing — rolled, earned experience toward her
/// level, and got nothing whatsoever that would make climbing easier next time.
/// The attempt was forgotten the moment the dice landed, which is the opposite
/// of how anybody learns anything.
///
/// This is the ledger of what she has actually been doing. Enough attempts at
/// the same kind of thing and it becomes a skill she really has.
model Practice {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Normalised, for counting: "climb", "persuade".
  key   String
  /// As the storyteller named it, for the announcement: "climbing".
  label String

  attempts Int @default(0)
  /// Set once this turned into a real skill, so it stops being counted twice.
  learnedAtTurn Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([characterId, key])
  @@index([characterId])
}

model CharacterSkill {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Matches a skill key from lib/game/character-options.ts.
  name String
  rank Int    @default(1)

  /// The level whose choice bought this, or null if she earned it by doing it.
  ///
  /// Both kinds sit in this table and should: a skill is a skill, and the sheet
  /// does not sort them into two lists. But "how many of her level-up choices
  /// has she spent" is unanswerable without knowing which is which, and a girl
  /// who practised her way to four skills should not lose her picks for it.
  chosenAtLevel Int?
  /// Progress toward the next rank, awarded when the skill is used well.
  xp   Int    @default(0)

  @@unique([characterId, name])
  @@index([characterId])
}

/// Something a character gave up, and what it bought.
///
/// The counterpart to spending an item on a quest. A brass key handed over to
/// open a door is gone from the pack — that is the point of it — but a child
/// who watched their find silently disappear from their sheet has been robbed,
/// not rewarded. So the item leaves the inventory and arrives here, naming what
/// it was for. Nothing anybody earned ever just vanishes.
model Keepsake {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name String
  /// "opened the door beneath the mill" — what giving it up accomplished.
  note String

  /// Which adventure it was spent on, so a sheet can say where.
  ///
  /// Nulled rather than deleted if the adventure ever is: giving something up
  /// happened to her whether or not the record of the story survives, and a
  /// shelf that quietly loses a row is worse than one that says "an adventure
  /// since forgotten".
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([characterId])
  @@index([campaignId])
}

/// How a quest came to exist.
enum QuestKind {
  /// One per chapter of the storyline, opened as the party reaches it.
  MAIN
  /// Something the storyteller introduced and the party may take or leave.
  SIDE
  /// One girl's own aim for a chapter. Hers to see and hers to finish, and
  /// shown to the rest of the party only once she has.
  PERSONAL
}

enum QuestStatus {
  ACTIVE
  COMPLETE
  /// The story moved past it. Kept, so the journal can be honest about what
  /// the party left undone rather than pretending it was never asked.
  ABANDONED
}

/// What an objective wants.
enum ObjectiveKind {
  /// Somebody has to be carrying the thing. Resolves itself by looking at the
  /// party's pockets, so the storyteller cannot forget to tick it off.
  FIND
  /// Something to do rather than hold. Only the storyteller can say it is done.
  DEED
}

/// Something the party is trying to accomplish.
///
/// The storyline has always described its chapters, and a chapter has always
/// been able to name things the party should come away holding — but none of it
/// was ever *recorded* as done. A screen could say "still looking for the brass
/// key" by comparing lists on every page load, and that was all: finding it
/// changed nothing, completed nothing, and was never announced.
///
/// A quest is that list made durable. It has a moment of completion, which is
/// the thing worth playing for.
model Quest {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind    QuestKind   @default(MAIN)
  status  QuestStatus @default(ACTIVE)
  title   String
  /// One line, in the players' own terms. Never the act's goal — that is
  /// written at the Game Master and gives away how the chapter works.
  summary String

  /// Which chapter this belongs to. Null for side quests, which arrive whenever
  /// the story throws them up rather than belonging to a chapter.
  actIndex Int?

  /// Whose aim this is, for a PERSONAL quest.
  ///
  /// Four players following one quest is one player with four mouths. A thread
  /// of her own — grounded in her calling, not the plot — is what makes the
  /// evening different for each of them.
  ///
  /// Private in the sense that it stays off everybody else's board until she
  /// finishes it, at which point the whole table is told. The storyteller
  /// always knows all of them; that is how it engineers her a moment.
  secretForCharacterId String?
  secretFor            Character? @relation("PersonalQuests", fields: [secretForCharacterId], references: [id], onDelete: Cascade)

  openedAtTurn    Int  @default(0)
  completedAtTurn Int?
  completedAt     DateTime?

  objectives QuestObjective[]

  createdAt DateTime @default(now())

  /// "One main quest per chapter" was a unique index here until personal
  /// quests arrived carrying a chapter of their own. Postgres would not have
  /// enforced the rule anyway once any column went null, so it is guarded where
  /// it can actually be checked — every opener looks before it creates, inside
  /// the turn's own transaction.
  @@index([campaignId])
  @@index([secretForCharacterId])
}

model QuestObjective {
  id      String @id @default(cuid())
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  kind ObjectiveKind @default(FIND)
  text String
  /// Display order, which for a chapter is the order the storyline listed them.
  position Int

  doneAtTurn Int?

  /// What actually satisfied a FIND, which is rarely the words the storyline
  /// used: the chapter asks for "the brass key" and a child comes back with
  /// "a small brass key, green at the teeth".
  itemName String?
  /// Who was carrying it. Recorded at the moment it is ticked off, so handing
  /// the item on afterwards does not rewrite who found it.
  foundByCharacterId String?
  foundBy            Character? @relation(fields: [foundByCharacterId], references: [id], onDelete: SetNull)

  /// Set when completing the quest spent the item — it left the pack and
  /// became a keepsake.
  consumed Boolean @default(false)

  @@index([questId])
  @@index([foundByCharacterId])
}

/// Something the party picked up, was given, or made. Kept per character
/// rather than per party so it survives a character leaving an adventure.
model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name        String
  description String?
  quantity    Int     @default(1)

  /// Which adventure it came from, so a journal can say where.
  foundInCampaignId String?

  /// What she needs before this is any use to her.
  ///
  /// The alternative to a gear shop. A thing found in the story can be beyond
  /// her for now — a silver flute she cannot play, a book she cannot read — and
  /// that is a far better reason to want to grow than a price tag. It sits in
  /// her pack, named and visible, until she has grown into it.
  ///
  /// Null on almost everything. Most objects are just objects.
  requiresSkill String?
  requiresRank  Int?
  /// Or a plain level, for things that are simply beyond a beginner.
  requiresLevel Int?

  /// True when it was packed before setting out rather than found on the way.
  ///
  /// Both kinds count toward a quest — bringing the rope from home is a
  /// perfectly good way to have a rope, and "we brought the rope!" is the whole
  /// payoff of packing one. The flag exists so a journal can tell the two
  /// apart, and so the packing screen knows which of an adventurer's things it
  /// is allowed to put back.
  brought Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([characterId, name])
  @@index([characterId])
}

/// How two characters are related. This is the heart of the family twist:
/// bonds grow when characters help each other, and unlock Family Moves that
/// neither can use alone.
enum RelationshipKind {
  PARENT
  CHILD
  SIBLING
  GRANDPARENT
  GRANDCHILD
  PET
  FRIEND
}

/// One row per pair, never two.
///
/// Storing both directions would mean two bond counters for one relationship,
/// which will drift apart the moment anything writes to only one of them. The
/// pair is stored with the lexicographically smaller character id as A, and
/// `aToB` describes A's role toward B — B's role is derived by inverting it.
model Relationship {
  id String @id @default(cuid())

  characterAId String
  characterA   Character @relation("RelationshipA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterBId String
  characterB   Character @relation("RelationshipB", fields: [characterBId], references: [id], onDelete: Cascade)

  /// A's role toward B. "A is the PARENT of B."
  aToB RelationshipKind

  /// Rises through play. Family Moves unlock at thresholds.
  bondLevel Int @default(0)
  bondXp    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterAId, characterBId])
  @@index([characterBId])
}

/// How long the family wants an adventure to run. Advice to the storyteller
/// about when an act has gone on long enough, not a hard limit.
enum Pacing {
  /// One evening.
  BRISK
  /// A few sessions.
  STANDARD
  /// Long and unhurried.
  LEISURELY
}

enum CampaignStatus {
  /// Created, party chosen, but the first scene has not been narrated yet.
  SETUP
  ACTIVE
  PAUSED
  COMPLETE
}

/// Where the answers are typed.
///
/// The story is the same either way — one transcript, one turn at a time. This
/// only decides whether the table shares a keyboard or brings its own.
enum InputMode {
  /// Everyone round one screen. The storyteller asks each adventurer in turn,
  /// one after another, and one person types.
  SHARED_SCREEN
  /// Everyone on their own phone or laptop, answering at the same time. The
  /// turn is taken once every adventurer has said what they are doing.
  OWN_DEVICE
}

/// One family's run through a storyline. The storyline is the sheet music;
/// the campaign is the performance, and it can wander a long way from the page.
model Campaign {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  storylineId String
  storyline   Storyline @relation(fields: [storylineId], references: [id])

  title String

  /// Typed in by another household to bring one of their adventurers along.
  /// Shaped like an invite code so the two read the same way out loud.
  joinCode String @unique

  /// Whether the girls roll their own dice or the app rolls for them. Changeable
  /// mid-adventure, because whether anybody remembered to bring the dice is not
  /// something to be decided once and lived with.
  diceMode DiceMode @default(SERVER)

  /// Whether the party shares a screen or answers from their own devices.
  /// Changeable at any point — a family that plays round the table on Sunday
  /// and from three bedrooms on Wednesday should not need two adventures.
  inputMode InputMode @default(SHARED_SCREEN)

  /// Copied from the storyline and the owner's preferences at creation, then
  /// owned by the campaign — changing your profile later must not silently
  /// rewrite how an adventure in progress is narrated.
  tone         Tone
  readingLevel ReadingLevel

  status          CampaignStatus @default(SETUP)
  /// 1-based; tracks which act of the storyline the party is working through.
  currentActIndex Int            @default(1)

  /// How far the act's clock has run — see lib/game/pressure.ts.
  ///
  /// Rises on a turn where the party got nowhere and nobody even rolled, and
  /// stays put when they tried something and the dice were unkind. Zeroed when
  /// it fills and the story turns, and again whenever an act ends: a new act is
  /// a new problem, and carrying a full clock into it would punish a party for
  /// something they already paid for.
  pressure        Int            @default(0)

  /// Durable facts the Game Master accumulates — locations, NPCs meets, plot
  /// threads. Empty until the engine lands in M4.
  worldState Json @default("{}")

  party   PartyMember[]
  invites PartyInvite[]
  scenes Scene[]
  familyMoveUses FamilyMoveUse[]
  listeningBonds ListeningBond[]
  pendingRoll    PendingRoll?
  quests   Quest[]
  keepsakes Keepsake[]
  memories Memory[]
  aiCalls  AiCall[]
  rounds   TurnRound[]
  screens  ScreenPairing[]
  abilityUses AbilityUse[]
  images      CampaignImage[]

  /// Increments once per completed party turn. Used for memory recency.
  turnCounter Int @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastPlayedAt DateTime?
  /// Copied onto the campaign at setup, like tone and reading level, so
  /// changing your mind later cannot rewrite an adventure already under way.
  pacing       Pacing    @default(STANDARD)
  snapshot     TurnSnapshot?
  /// Set when the final act closes, so a finished adventure reads as finished
  /// rather than as one nobody has opened in a while.
  completedAt  DateTime?

  @@index([ownerId])
  @@index([storylineId])
}

/// A character travelling in a campaign. Characters outlive campaigns and may
/// appear in several, so the party is a join rather than a field on Character.
model PartyMember {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Order the game asks "what do you do?" around the table.
  position Int
  joinedAt DateTime @default(now())

  @@unique([campaignId, characterId])
  @@index([characterId])
}

enum InviteStatus {
  /// Asked, not yet answered.
  PENDING
  /// Answered yes. A PartyMember row exists from that moment on.
  ACCEPTED
  /// Answered no. Kept rather than deleted so the person who asked can see
  /// they were answered, instead of watching the invitation quietly vanish.
  DECLINED
}

/// An invitation for somebody else's adventurer to come along.
///
/// This is the other half of the join code. A code is for the person standing
/// next to you; an invitation is for the person upstairs, or at their mother's
/// — you pick their adventurer, they get asked, and nothing happens until they
/// say yes. It is what lets a family start an adventure together without one
/// account having to own every character in it.
///
/// Deliberately not a PartyMember with a flag. An invited adventurer is not in
/// the party: they must not appear in the storyteller's context, on the party
/// sheets, or in the list of people a round is waiting for. Keeping them in a
/// separate table means none of those places has to remember to exclude them.
model PartyInvite {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Who is being asked. The invitation is addressed to the adventurer rather
  /// than the account, because that is what the person inviting knows — and if
  /// the character is handed over before it is answered, the invitation
  /// correctly follows them to whoever holds them now.
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("PartyInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  status      InviteStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())

  /// One invitation per adventurer per adventure. Asking twice re-uses the row.
  @@unique([campaignId, characterId])
  @@index([characterId])
  @@index([invitedById])
}

enum RoundMode {
  /// A turn: the storyteller adjudicates, dice are rolled, the story moves on.
  ACTION
  /// Talking to each other. One model call, no dice, no consequences.
  TALK
}

enum RoundStatus {
  /// Waiting for the party. Answers can still be changed.
  COLLECTING
  /// Everyone is in and one player's browser is running the turn.
  RESOLVING
  /// The turn was taken. The transcript is the record from here on.
  RESOLVED
  /// Abandoned before it was taken.
  CANCELLED
}

/// One round of "what do you do?", collected from several devices at once.
///
/// This exists only for OWN_DEVICE campaigns. On a shared screen the answers
/// never need to outlive the page: one person types all of them and presses
/// send. Apart, they need somewhere to wait for each other — and that somewhere
/// has to be the database, because two phones share nothing else.
///
/// The turn itself is unchanged. A round is a waiting room in front of it: when
/// the last adventurer answers, exactly one browser wins the claim below and
/// runs the same pipeline the shared screen runs, with the same result for
/// everybody. That is what keeps the adventure single-threaded while the typing
/// is not.
model TurnRound {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// 1-based within the campaign, and the reason two devices cannot open two
  /// rounds at once: the second insert loses the unique constraint and its
  /// owner is handed the round that already exists.
  number Int
  mode   RoundMode   @default(ACTION)
  status RoundStatus @default(COLLECTING)

  /// The pipeline stage the resolving browser last reported, so that every
  /// other screen can say "rolling the dice" at the same moment.
  stage String?

  /// Who is running the turn, and since when. A claim older than a turn could
  /// possibly take belongs to a browser that was closed mid-turn, and may be
  /// taken over.
  claimedById String?
  claimedAt   DateTime?

  /// The Family Move the table chose: { key, helperId, targetId }.
  familyMove Json?

  /// True when this round is retelling a turn that was taken back. Its answers
  /// arrive already filled in, so it must not start the moment it loads: the
  /// table is here to change something, and needs to say when it is ready.
  retelling Boolean @default(false)
  /// What the table says the last telling got wrong, typed during a retelling
  /// and handed to the storyteller as what really happened.
  correction String?
  /// Why the last attempt failed. Shown to everyone, and cleared on retry —
  /// a failed turn returns the round to COLLECTING rather than losing what
  /// everybody typed.
  error String?

  answers RoundAnswer[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@unique([campaignId, number])
  @@index([campaignId, status])
}

/// One adventurer's answer within a round.
model RoundAnswer {
  id      String    @id @default(cuid())
  roundId String
  round   TurnRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Who typed it, so the screen can say "you" and so an answer can only be
  /// changed by the person who wrote it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  text String
  /// "Waits and watches" — ready, but doing nothing. Distinct from an empty
  /// answer, which means nobody has spoken yet.
  waiting Boolean @default(false)

  /// A once-a-scene or once-a-chapter ability she is spending on this answer.
  ///
  /// Held on the answer rather than chosen once at review the way a Family Move
  /// is, because a signature belongs to one girl. On her own phone she is the
  /// one who decides to spend it, and it has to survive her changing her answer
  /// twice before the round resolves.
  abilityKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, characterId])
  @@index([characterId])
  @@index([userId])
}

enum SceneStatus {
  OPEN
  /// Closed scenes have been summarised and their turns collapsed into memory.
  CLOSED
}

/// A chapter of play. Scenes exist so that history can be compressed: once a
/// scene closes, its turns are summarised and only the summary travels forward
/// in the prompt.
model Scene {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// 1-based, within the campaign.
  index    Int
  title    String
  /// Where this is happening, in the GM's words.
  location String?

  /// Rolling summary, rewritten when the scene closes.
  summary String?

  actIndex Int         @default(1)
  status   SceneStatus @default(OPEN)

  turns TurnEvent[]
  image SceneImage?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@unique([campaignId, index])
  @@index([campaignId, status])
}

enum TurnEventType {
  /// Prose from the Game Master.
  NARRATION
  /// What a player typed.
  PLAYER_ACTION
  /// A resolved dice check.
  DICE_ROLL
  /// Scene changes, act advances, notes to the table.
  SYSTEM
}

/// The append-only record of everything that happened.
///
/// This is the source of truth for a campaign; scene summaries, memories and
/// world state are all projections of it. Nothing here is ever updated in
/// place, which is what makes "undo the last turn" tractable later.
model TurnEvent {
  id      String @id @default(cuid())
  sceneId String
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  /// Monotonic within the scene.
  ordinal Int
  type    TurnEventType

  /// Which character this is about. Null for narration and system events.
  actorCharacterId String?

  content String

  /// Type-specific extras: dice detail, stat used, difficulty, outcome.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@unique([sceneId, ordinal])
  @@index([sceneId])
}

/// A picture of an adventurer, uploaded by whoever plays them.
///
/// Uploaded rather than generated, deliberately. A child who has drawn their own
/// character in felt-tip wants *that* on the sheet, and a photograph of it beats
/// anything a model would invent — it costs nothing, needs no provider, and asks
/// nobody's permission to put a likeness of a real family through an API.
///
/// Shrunk in the browser before it is sent, so what arrives is a portrait rather
/// than a twelve-megapixel photograph of a fridge.
model CharacterPortrait {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String

  /// Bumped on every replacement, so a cached portrait is never the old one.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// A picture of one chapter, drawn once and kept.
///
/// One per scene rather than per turn: a scene is a place the party is in for a
/// while, so a picture of it stays true for several turns, and drawing on every
/// turn would cost real money for pictures nobody has finished looking at.
///
/// The bytes live in the database rather than on disk, because the container is
/// replaced on every deployment and a picture of the night the dragon learned
/// her name should outlive a redeploy. They are small — one low-detail square
/// each — and there are as many of them as there are chapters.
model SceneImage {
  id      String @id @default(cuid())
  sceneId String @unique
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String @default("image/png")

  /// What the picture was asked for, kept so an odd one can be understood
  /// rather than only regenerated and hoped about.
  prompt String
  model  String

  createdAt DateTime @default(now())
}

enum MemoryKind {
  FACT
  NPC
  PLACE
  PLOT_THREAD
}

/// Durable things the Game Master should not forget.
///
/// A local model cannot be handed twenty sessions of transcript, so the prompt
/// carries a ranked selection of these instead. Importance is set by the
/// extraction step and decays in ranking as turns pass without a mention.
model Memory {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind MemoryKind
  /// Short handle used for de-duplication, e.g. "the beekeeper".
  key  String
  content String

  /// 1 (incidental) to 5 (central to the story).
  importance Int @default(3)
  /// Global turn counter at last mention, for recency ranking.
  lastSeenAt Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, kind, key])
  @@index([campaignId, importance])
}

/// Every call to the model, kept so that "the Game Master went weird" is a
/// debuggable event rather than a mystery.
model AiCall {
  id         String    @id @default(cuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// adjudicate | narrate | extract | summarise
  stage String
  model String

  latencyMs Int
  ok        Boolean

  /// Reported by hosted providers only; null for most local servers. Kept so a
  /// session's cost can be added up after the fact rather than estimated.
  inputTokens  Int?
  outputTokens Int?
  /// How many repair attempts were needed before the response parsed.
  repairs   Int     @default(0)
  error     String?

  /// Truncated prompt and response, for reading back what actually happened.
  promptPreview   String?
  responsePreview String?

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

/// A record that a Family Move was spent, so it can be limited to once per
/// scene. Storing uses rather than a cooldown counter means the limit survives
/// a restart and can be shown in the UI without recomputing anything.
model FamilyMoveUse {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sceneId        String
  relationshipId String
  /// Matches a key from FAMILY_MOVES in lib/game/rules.ts.
  moveKey        String

  /// Campaign turn counter at the moment it was used.
  usedAtTurn Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([sceneId, relationshipId, moveKey])
  @@index([campaignId])
}

/**
 * One pair listening to each other, once per scene.
 *
 * Talking it over now deepens a bond, and this is the ceiling on it. Without a
 * ceiling the fastest way up the ladder would be to open the conversation box
 * and type "hi" at each other eleven times, which is precisely the opposite of
 * the behaviour the feature exists to reward.
 *
 * Modelled on FamilyMoveUse — same shape, same once-per-scene unique key —
 * because it is the same kind of fact: a thing this pair has already had out of
 * this scene.
 */
model ListeningBond {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sceneId        String
  relationshipId String

  createdAt DateTime @default(now())

  @@unique([sceneId, relationshipId])
  @@index([campaignId])
}

/**
 * A turn stopped halfway, waiting for the table to throw its dice.
 *
 * The pipeline is one long run — adjudicate, roll, narrate, extract — and real
 * dice cut it in half: the storyteller has to ask before it can carry on. So
 * everything needed to finish sits here until the numbers arrive.
 *
 * Stored rather than held in memory because the gap is a person picking a die
 * off the floor. A phone that locks, a browser that reloads, a parent who
 * wanders off to fetch the popcorn — none of those should cost the table its
 * turn.
 *
 * One per adventure, replaced rather than queued: a table cannot be halfway
 * through two turns at once, and the newest ask is always the real one.
 */
model PendingRoll {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sceneId String

  /// Everything the turn needs to resume: the declared actions, the family move
  /// and the adjudication already paid for. Kept whole rather than normalised
  /// because nothing ever queries inside it — it is written once, read once and
  /// deleted.
  payload Json

  /// What the table is being asked for, ready to render. Separate from the
  /// payload so a phone can show the question without being handed the turn's
  /// entire innards.
  awaited Json

  createdAt DateTime @default(now())
}

enum AiProviderKind {
  /// Anything speaking OpenAI's /v1/chat/completions: Ollama, vLLM, LM Studio,
  /// OpenAI itself, OpenRouter, Groq, Together, DeepSeek.
  OPENAI_COMPATIBLE
  /// Anthropic's /v1/messages, which is a different shape entirely.
  ANTHROPIC
}

/// The storyteller's connection settings, editable from the admin UI so the
/// model can be changed without a redeploy.
///
/// A single row, pinned to id "singleton". Environment variables remain the
/// fallback, so a fresh deployment works before anyone visits the settings page.
model AiSetting {
  id String @id @default("singleton")

  kind    AiProviderKind @default(OPENAI_COMPATIBLE)
  baseUrl String
  model   String
  /// Optional second model used only for narration.
  narrationModel String?

  /// AES-256-GCM ciphertext. The key lives in the environment, never the
  /// database, so a database dump alone cannot reveal it.
  apiKeyCipher String?
  /// Kept so the UI can show "sk-ant-…4f2a" without decrypting anything.
  apiKeyHint   String?

  maxContextTokens Int @default(3000)
  timeoutMs        Int @default(120000)

  /// Sent as `reasoning_effort`. Null leaves the field off the request entirely,
  /// because OpenAI rejects values it does not recognise. "none" is what stops a
  /// thinking model such as Qwen3 spending its whole output budget on
  /// chain-of-thought and returning an empty answer.
  reasoningEffort String?

  /// Pictures are a separate provider from prose, and usually a different
  /// company: Anthropic draws nothing, and a family running a local model for
  /// the storytelling still has to reach out somewhere to get a picture. Off by
  /// default, because unlike everything else here it costs money per use.
  imagesEnabled  Boolean @default(false)
  imageBaseUrl   String?
  imageModel     String?
  imageApiKeyCipher String?
  imageApiKeyHint   String?

  /// What the provider charges, in whole currency units per million tokens, and
  /// per picture. Optional and unset by default: prices change monthly and
  /// differ per provider, so a number baked into the code would be a confident
  /// lie. Given these, the usage page reports money; without them it reports
  /// tokens and says why.
  inputPricePer1M  Float?
  outputPricePer1M Float?
  imagePrice       Float?
  currency         String @default("USD")

  /// Result of the last connection test, so the page can show the state it was
  /// left in rather than looking untested after every reload.
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  lastTestNote String?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// A pre-authored adventure template. The AI improvises freely inside it,
/// but the acts give it a spine so the story goes somewhere.
model Storyline {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  tagline         String
  premise         String
  /// The opening situation the GM narrates in scene one.
  hook            String
  defaultTone     Tone           @default(COZY)
  readingLevel    ReadingLevel   @default(FAMILY_MIXED)
  minPlayers      Int            @default(2)
  maxPlayers      Int            @default(5)
  estimatedScenes Int            @default(12)

  /// What this adventure's clock is called, in the story's own words.
  ///
  /// "The fog", "The stars going out", "Three days to the festival". Shown to
  /// the table as it fills and handed to the storyteller as the name of the
  /// thing that gets worse when nobody is getting anywhere. Named per adventure
  /// rather than generically because "pressure: 4/8" teaches a child a rule,
  /// and "the fog has reached the bakery" teaches her a story.
  pressureName    String         @default("The clock")

  isActive        Boolean        @default(true)

  /// True once a person has written or edited this adventure in the app.
  ///
  /// The seed re-runs on every container start and replaces the acts of every
  /// storyline it knows about, which is right for the ones it ships and
  /// catastrophic for one somebody wrote on a Sunday evening. This flag is what
  /// the seed checks before touching anything: set it, and the file stops being
  /// the source of truth for this row.
  isCustom        Boolean        @default(false)

  acts            StorylineAct[]
  campaigns       Campaign[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive])
}

/// One act of a storyline. `beats` are optional waypoints the GM should try to
/// reach — not a script. Players are free to ignore them entirely.
model StorylineAct {
  id          String    @id @default(cuid())
  storylineId String
  storyline   Storyline @relation(fields: [storylineId], references: [id], onDelete: Cascade)
  /// 1-based position within the storyline.
  index       Int
  title       String
  /// What this act is meant to accomplish, written as guidance to the GM.
  goal        String
  beats       String[]

  /// Things the party is meant to come away from this act holding.
  ///
  /// Guidance, like beats: the storyteller is told to make them findable, not
  /// to force them into anybody's hands, and a party that solves the act
  /// another way is not stopped. Naming them is what lets a screen say "still
  /// looking for the brass key" instead of the family keeping that list in
  /// their heads.
  seeks       String[]

  @@unique([storylineId, index])
  @@index([storylineId])
}

/// The state a campaign was in immediately before its most recent turn.
///
/// One row per campaign, overwritten each turn: undo reaches exactly one turn
/// into the past, which is what a table actually asks for when a child mistypes
/// or a beat lands wrong. Keeping a history would grow without bound and invite
/// a much harder question about how far back is safe.
model TurnSnapshot {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The turn number this restores to, so the table can be told what it undoes.
  turnCounter Int
  /// First TurnEvent ordinal the turn wrote. Everything from here is removed.
  fromOrdinal Int
  /// Everything a turn can change. JSON because the shape is an implementation
  /// detail of the undo rather than something anything else queries.
  state Json

  createdAt DateTime @default(now())
}

/// A television showing one adventure.
///
/// The screen in the living room has no account and never gets one. Signing a
/// TV into the household would put a session that can delete adventures on the
/// device with the least supervision in the house, kept alive by a browser
/// nobody signs out of — and it would have to be typed with a remote control.
///
/// So the TV asks to be adopted instead. It opens the display cold, shows a
/// code, and somebody already holding the adventure on their phone types that
/// code in. The pairing is done on the device with a keyboard and an account;
/// the television only ever receives.
///
/// What it receives is one adventure, read-only, and less of it than a player
/// sees — see `lib/game/screen.ts`.
model ScreenPairing {
  id String @id @default(cuid())

  /// Shown on the television while it waits to be adopted, and typed into a
  /// phone to adopt it. Cleared once claimed: it is a doorbell, not a key, and
  /// leaving it around would let a second household ring the same bell.
  code       String?   @unique
  /// When the code stops being typeable. Minutes, not days — the phone is in
  /// the room, and a code that outlives the moment is only a way for somebody
  /// else's adventure to arrive on this television.
  codeExpiresAt DateTime?

  /// sha256 of the token the television keeps. The key, and unlike the code it
  /// is long, never displayed, and never read aloud.
  tokenHash String @unique

  /// Null until somebody adopts it. This is the whole of the screen's
  /// authority: one adventure, set once by an account that could already see
  /// it, changed only by unpairing.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// What to call this television on the phone that paired it, so a house with
  /// two of them can tell which is which.
  label String?

  createdAt DateTime  @default(now())
  claimedAt DateTime?
  /// Bumped as the television polls. A screen that has not asked for anything
  /// in a fortnight has been turned off, moved on, or sold.
  lastSeenAt DateTime @default(now())

  @@index([campaignId])
  @@index([lastSeenAt])
}

/// What a character has spent, and in which window.
///
/// Modelled on `FamilyMoveUse`, which was for a long time the only limit in the
/// game that a limit actually was. Signatures said "once a scene" in their own
/// doc comment, Steady Hand and two knacks said "once a chapter" in the text a
/// child reads — and nothing anywhere counted. The prompt went further and told
/// the storyteller the archetype signature was something the character "can
/// always" do, so the one place the rule could still have been enforced was
/// actively told the opposite.
///
/// One table for all three kinds rather than three tables, because the question
/// asked of it is always the same: has she used this one, in this window, yet.
model AbilityUse {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  kind AbilityKind
  /// The archetype signature name, the knack key, or `rank2:<skill>` — see
  /// `abilityKeyFor` in lib/game/abilities.ts.
  abilityKey String

  /// The window the limit is measured in, as `scene:<id>` or `act:<index>`.
  ///
  /// A string rather than two nullable columns with a conditional constraint,
  /// because the two scopes are asked the same question and a partial unique
  /// index that only covers half the rows is how a "once a chapter" ability
  /// quietly becomes unlimited. One column, one constraint, no gap.
  windowKey String

  /// Campaign turn counter at the moment it was spent, for undo and the journal.
  usedAtTurn Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([characterId, abilityKey, windowKey])
  @@index([campaignId])
  @@index([campaignId, characterId])
}

enum AbilityKind {
  /// The one thing this calling alone can do. Once a scene.
  SIGNATURE
  /// Chosen at a level-up. Only the ones with a limit are recorded here.
  KNACK
  /// Earned by practising one skill to rank 2 — Steady Hand. Once a chapter.
  RANK
}


/// What a picture the family made is a picture *of*.
enum CampaignImageKind {
  /// A chapter or a moment. Keyed by scene id.
  SCENE
  /// Somebody they met. Keyed by a normalised version of the name.
  PERSON
  /// Somewhere they have been, and might go back to.
  PLACE
}

/// A picture somebody at this table drew, photographed and uploaded.
///
/// Scene art has always been available and always been *generated* — asked for
/// from whatever drawing model the household configured, which most households
/// have not configured, and which in any case produces one interpretation of a
/// chapter rather than the family's own.
///
/// This is the other half, and the better one. A ten-year-old draws the
/// beekeeper in felt-tip on a Tuesday and he is on the television that evening,
/// with his own face, for the rest of the adventure. A generated picture is
/// content; a drawn one is a memento, and the whole game is built around
/// mementos.
///
/// One table for all three kinds rather than three tables, because the question
/// asked of it is always the same: is there a picture of this thing, and which
/// bytes are it. `kind` plus `key` is the address.
model CampaignImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind CampaignImageKind
  /// A scene id for SCENE, a normalised name for PERSON and PLACE.
  key  String
  /// What to write underneath: "The beekeeper", "The drowned schoolhouse".
  label String

  data     Bytes
  mimeType String

  /// Bumped on every replacement, so a picture cached on one child's phone is
  /// never the one that has since been redrawn.
  version Int @default(1)

  /// Who added it. Kept so the gallery can say whose drawing it is, and set to
  /// null rather than cascading if that account ever goes — the picture belongs
  /// to the adventure now.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, kind, key])
  @@index([campaignId])
}


/// A picture of one chapter of one adventure, used by every family who plays it.
///
/// Keyed by the storyline's **slug and act number**, deliberately, rather than
/// by the act's id. The seed deletes and recreates every act row on container
/// start — see `prisma/seed.ts` — so art hung off an act id would be destroyed
/// by the next redeploy, which is exactly when somebody would have just added
/// it. Slug and number survive that, and they are also what the art-prompt
/// sheet names its files after.
///
/// Distinct from `CampaignImage` on purpose. That is one family's drawing of
/// their own chapter; this is the picture the adventure ships with, and every
/// table that plays it sees the same one. When both exist the family's own wins
/// — see `lib/game/scene-picture.ts`.
model ChapterImage {
  id String @id @default(cuid())

  storylineSlug String
  /// 1-based, matching StorylineAct.index.
  actIndex      Int

  data     Bytes
  mimeType String

  /// Bumped on replacement, so a redrawn chapter is not the old one on every
  /// device that has already seen it.
  version Int @default(1)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storylineSlug, actIndex])
}
